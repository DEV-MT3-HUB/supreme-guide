local function MeleeKaitunLogic()
	SetStatus("melee | checking styles")
	if Character then
		local beli = LocalPlayer.Data.Beli.Value
		if not CollectionService:HasTag(Character, "Buso") and beli >= 25000 then CommF_:InvokeServer("BuyHaki", "Buso") end
		if not CollectionService:HasTag(Character, "Geppo") and beli >= 10000 then CommF_:InvokeServer("BuyHaki", "Geppo") end
		if not CollectionService:HasTag(Character, "Soru") and beli >= 100000 then CommF_:InvokeServer("BuyHaki", "Soru") end
	else return end
	if not CheckedMelee then CheckMeleeMastery() end
	for _, v in {"BlackLeg", "Electro", "FishmanKarate"} do
		local realName = v:gsub("(%l)(%u)", "%1 %2")
		if (MeleeData[v] or 0) < 400 then
			SetItem("melee: " .. realName .. " " .. tostring(MeleeData[v] or 0) .. "/400")
			if (MeleeData[v] or 0) == 0 and LocalPlayer.Data.Beli.Value < MeleePrices[v].Price.Beli then return end
			if not HasItem(realName) then
				if not TweenToMeleeBuyer(v) then return end
				task.wait(0.5)
				CommF_:InvokeServer("Buy" .. v)
			end
			return
		end
	end
	if not World.Sea1() then
		for _, v in {"DragonClaw", "Superhuman", "DeathStep", "SharkmanKarate"} do
			local realName = v:gsub("(%l)(%u)", "%1 %2")
			if (MeleeData[v] or 0) < 400 then
				local hasEnoughEco = ((MeleePrices[v].Price.Beli == nil) or (LocalPlayer.Data.Beli.Value >= MeleePrices[v].Price.Beli)) and ((MeleePrices[v].Price.Fragments == nil) or (LocalPlayer.Data.Fragments.Value >= MeleePrices[v].Price.Fragments))
				if (MeleeData[v] or 0) == 0 and hasEnoughEco then
					if v ~= "DragonClaw" and v ~= "Superhuman" then GetMeleeLogics[v](); return true
					else
						TweenToMeleeBuyer(v)
						if v == "Superhuman" then CommF_:InvokeServer("Buy" .. v)
						else CommF_:InvokeServer("BlackbeardReward", "DragonClaw", "2") end
					end
				elseif (MeleeData[v] or 0) == 0 and (MeleePrices[v].Price.Fragments and (LocalPlayer.Data.Fragments.Value < MeleePrices[v].Price.Fragments)) and CheckCanDungeon() then
					if (not World.Sea1()) and LocalPlayer.Data.Level.Value >= 1250 then AutoDungeon() end
				elseif (MeleeData[v] or 0) > 0 and not HasItem(realName) then
					if not TweenToMeleeBuyer(v) then break end
					if v == "DragonClaw" then CommF_:InvokeServer("BlackbeardReward", "DragonClaw", "2")
					else CommF_:InvokeServer("Buy" .. v) end
				end
				return
			end
		end
		for _, v in {"ElectricClaw", "DragonTalon", "Godhuman"} do
			local realName = v:gsub("(%l)(%u)", "%1 %2")
			if (MeleeData[v] or 0) < 400 then
				local hasEnoughEco = ((MeleePrices[v].Price.Beli == nil) or (LocalPlayer.Data.Beli.Value >= MeleePrices[v].Price.Beli)) and ((MeleePrices[v].Price.Fragments == nil) or (LocalPlayer.Data.Fragments.Value >= MeleePrices[v].Price.Fragments))
				if (MeleeData[v] or 0) == 0 and hasEnoughEco then
					if v == "Godhuman" then GetGodHuman()
					else GetMeleeLogics[v]() end
					return true
				elseif (MeleeData[v] or 0) == 0 and (MeleePrices[v].Price.Fragments and (LocalPlayer.Data.Fragments.Value < MeleePrices[v].Price.Fragments)) and CheckCanDungeon() then
					if (not World.Sea1()) and LocalPlayer.Data.Level.Value >= 1250 then AutoDungeon() end
				elseif (MeleeData[v] or 0) > 0 and not Character:FindFirstChild(realName) and not LocalPlayer.Backpack:FindFirstChild(realName) then
					if not TweenToMeleeBuyer(v) then break end
					CommF_:InvokeServer("Buy" .. v)
				end
				return
			end
		end
	end
end

