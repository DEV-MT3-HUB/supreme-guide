LastServersDataPulled = 0
CachedServers = {}
local function IfTableHaveIndex(k) for _ in k do return true end end
local function GetServers()
    if LastServersDataPulled and os.time() - LastServersDataPulled < 60 then return CachedServers end
    for i = 1, 100 do
        local W = ReplicatedStorage:WaitForChild("__ServerBrowser"):InvokeServer(i)
        if IfTableHaveIndex(W) then LastServersDataPulled = os.time(); CachedServers = W; return W end
    end
end
local function HopLowServer()
    for i, v in GetServers() do if v.Count <= 5 then return ReplicatedStorage.__ServerBrowser:InvokeServer("teleport", i) end end
end

local FILE_NAME = "serverhop_cache.json"
local visited = {}
if isfile and isfile(FILE_NAME) then
    local ok, data = pcall(function() return HttpService:JSONDecode(readfile(FILE_NAME)) end)
    if ok and type(data) == "table" then visited = data end
end
local function saveCache() if writefile then writefile(FILE_NAME, HttpService:JSONEncode(visited)) end end

local _serverHopAtivo = false
local ServerHop = function()
    if _serverHopAtivo then return false end
    _serverHopAtivo = true
    SetStatus("boss hop: searching")
    SetFarm("hopping server...")
    for _ = 1, 5 do
        local ok, data = pcall(function()
            return HttpService:JSONDecode(game:HttpGet("https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100"))
        end)
        if not ok or not data or not data.data then break end
        table.sort(data.data, function(a, b) return (a.playing or 0) < (b.playing or 0) end)
        for _, server in ipairs(data.data) do
            local slots = (server.maxPlayers or 0) - (server.playing or 0)
            if slots >= 2 and server.id ~= game.JobId and not visited[server.id] then
                visited[server.id] = true
                saveCache()
                SetFarm("hop " .. tostring(server.playing) .. "/" .. tostring(server.maxPlayers))
                local jobAntes = game.JobId
                pcall(function() ReplicatedStorage.__ServerBrowser:InvokeServer("teleport", server.id) end)
                task.wait(Config.BossHopDelay or 3)
                if game.JobId ~= jobAntes then _serverHopAtivo = false; return true end
            end
        end
    end
    _serverHopAtivo = false
    HopLowServer()
    return false
end

local function KillMonster(_v)
    SetStatus("combat: " .. string.lower(tostring(_v)))
    SetFarm("fighting " .. string.lower(tostring(_v)))
    if not Character or not Character:FindFirstChildOfClass("Humanoid") then return end
    local killed = false
    for _, v2 in {workspace.Enemies, ReplicatedStorage} do
        for _, v in v2:GetChildren() do
            if v.Name:find(_v) and v.PrimaryPart and v:FindFirstChildOfClass("Humanoid") then
                killed = true
                local sk = tick()
                repeat
                    task.wait()
                    if not v or not v.PrimaryPart or not v:FindFirstChildOfClass("Humanoid") or v.Humanoid.Health <= 0 then break end
                    Tween(v.PrimaryPart.Position + Vector3.new(0, 25, 7), 350)
                    if LocalPlayer:DistanceFromCharacter(v.PrimaryPart.CFrame.Position) <= 200 then
                        Tween(v.PrimaryPart.Position + Vector3.new(0, 25, 7), math.huge)
                        if LocalPlayer:DistanceFromCharacter(v.PrimaryPart.CFrame.Position) <= 50 then
                            BringEnemy(v); EquipWeapon(); Attack()
                        end
                    end
                until (tick() - sk) >= 120
                break
            end
        end
        if killed then break end
    end
    if not killed and IsBoss(_v) then
        SetStatus("boss " .. _v .. " missing")
        ServerHop()
    end
end

