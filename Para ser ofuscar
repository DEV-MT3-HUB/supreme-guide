-- =================== FARM LEVEL (COM TROCA AUTOMÁTICA DE QUEST) ===================
local lastTakeQuest = 0
local function FarmLevelLogic()
    CheckQuest()
    if not Monster then return end

    local MyLevel = LocalPlayer.Data.Level.Value
    local oldQuestName = QuestController.CurrentQuestName
    local needsNewQuest = not GetQuestData() or oldQuestName ~= NameQuest

    if needsNewQuest then
        if oldQuestName ~= "" and oldQuestName ~= NameQuest then
            SetStatus("switching quest: " .. oldQuestName .. " → " .. NameQuest)
            SetFarm("abandoning " .. oldQuestName)
            pcall(function() CommF_:InvokeServer("AbandonQuest") end)
            task.wait(0.5)
            QuestController:Reset()
            lastTakeQuest = 0
        end
        if (tick() - lastTakeQuest) > 1 then
            lastTakeQuest = tick()
            SetStatus("new quest: " .. NameQuest)
            SetFarm("traveling to quest giver | " .. NameQuest)
            if CFrameQ then
                if LocalPlayer:DistanceFromCharacter(CFrameQ.Position) > 15 then
                    TweenWithRespawnRetry(CFrameQ, 350)
                end
                if LocalPlayer:DistanceFromCharacter(CFrameQ.Position) <= 15 then
                    CommF_:InvokeServer("StartQuest", NameQuest, LevelQuest)
                    task.wait(0.5)
                end
            end
            return
        end
    end

    SetStatus("farming: " .. Monster .. " (lv " .. tostring(MyLevel) .. ")")
    SetFarm("quest: " .. (NameQuest or "?") .. " | " .. Monster)

    local startLevel = MyLevel
    local startMonster = Monster
    local startNameQuest = NameQuest
    local foundMob = false

    for _, v2 in workspace.Enemies:GetChildren() do
        if v2.Name == startMonster and v2:FindFirstChild("Humanoid") and v2.Humanoid.Health > 0 then
            foundMob = true
            local hrp = v2:FindFirstChild("HumanoidRootPart") or v2.PrimaryPart
            if hrp then
                local sk = tick()
                repeat
                    task.wait()
                    if LocalPlayer.Data.Level.Value ~= startLevel then
                        CheckQuest()
                        if Monster ~= startMonster or NameQuest ~= startNameQuest then
                            SetStatus("level up! switching quest")
                            SetFarm("abandoning " .. startNameQuest .. " → " .. NameQuest)
                            pcall(function() CommF_:InvokeServer("AbandonQuest") end)
                            task.wait(0.5)
                            QuestController:Reset()
                            lastTakeQuest = 0
                            return
                        end
                    end
                    if not v2 or not v2:FindFirstChild("Humanoid") or v2.Humanoid.Health <= 0 then break end
                    Tween(hrp.Position + Vector3.new(0, 20, 5), 350)
                    if LocalPlayer:DistanceFromCharacter(hrp.Position) <= 200 then
                        Tween(hrp.Position + Vector3.new(0, 20, 5), math.huge)
                        if LocalPlayer:DistanceFromCharacter(hrp.Position) <= 40 then
                            BringEnemy(v2); EquipWeapon(); Attack()
                        end
                    end
                until (tick() - sk) >= 120
            end
            break
        end
    end
    if not foundMob and CFrameMon then
        SetFarm("waiting " .. startMonster .. " spawn")
        TweenWithRespawnRetry(CFrameMon, 350)
    end
end

