function fmt(n)
    if type(n) ~= "number" then return "N/A" end
    if n >= 1e12 then return string.format("%.2fT", n/1e12) end
    if n >= 1e9 then return string.format("%.2fB", n/1e9) end
    if n >= 1e6 then return string.format("%.2fM", n/1e6) end
    if n >= 1e3 then return string.format("%.1fK", n/1e3) end
    return tostring(math.floor(n))
end
local function getDataVal(name)
    local plr = Players.LocalPlayer
    if not plr then return nil end
    local ok, data = pcall(function() return plr.Data end)
    if not ok or not data then return nil end
    local v = data:FindFirstChild(name)
    return v and v.Value or nil
end
local function hasTool(name)
    local plr = Players.LocalPlayer
    if not plr then return false end
    local function inC(c) for _, v in pairs(c:GetChildren()) do if v.Name == name then return true end end; return false end
    if plr:FindFirstChild("Backpack") and inC(plr.Backpack) then return true end
    if plr.Character and inC(plr.Character) then return true end
    return false
end
local function hasStyle(name)
    local plr = Players.LocalPlayer
    if not plr then return false end
    local found = false
    pcall(function()
        local data = plr.Data
        if data then
            local styles = data:FindFirstChild("FightingStyles")
            if styles then
                for _, v in pairs(styles:GetChildren()) do
                    if string.lower(v.Name) == string.lower(name) then found = true end
                    if v:IsA("StringValue") and string.lower(v.Value) == string.lower(name) then found = true end
                end
            end
        end
    end)
    if found then return true end
    if plr.Character then
        for _, v in pairs(plr.Character:GetChildren()) do
            if string.lower(v.Name) == string.lower(name) then return true end
        end
    end
    return false
end
