            { Vector3.new(-6509, 83, -133), Vector3.new(-6509, 83, -133) },
        }
    elseif World1 then
        _is = {
            { Vector3.new(61163.85, 11.68, 1819.78), Vector3.new(4050.31, -1.69, -1814.12) },
            { Vector3.new(3864.85, 6.68, -1926.78), Vector3.new(61170.05, -2, 1952.83) },
            { Vector3.new(-4166.61, 1093.70, -347.16), Vector3.new(-6020.28, 5469.16, 2209.78) },
        }
    else return end
    local min, pos = nil, 1
    for i, v in ipairs(_is) do
        local d = (t - v[1]).Magnitude
        if min == nil or d < min then min = d; pos = i end
    end
    local dist = LocalPlayer:DistanceFromCharacter(t)
    local disttotp = LocalPlayer:DistanceFromCharacter(_is[pos][2])
    if (min + disttotp) < dist and (tick() - LastTravel) >= 1 then
        LastTravel = tick()
        tw = RunTween(_is[pos][2])
        if tw then tw.Completed:Wait() end
        task.wait(0.25)
        if not CollectionService:HasTag(LocalPlayer, "Teleporting") then
            CommF_:InvokeServer("requestEntrance", _is[pos][1])
        end
        local t0 = tick()
        repeat task.wait() until (LocalPlayer:DistanceFromCharacter(_is[pos][1]) < LocalPlayer:DistanceFromCharacter(_is[pos][2])) or (tick() - t0) > 10
    end
end

local function Tween(v, speed, high)
    if not Character or not Character.PrimaryPart or not Character:FindFirstChild("Humanoid") then return end
    pcall(SmartTween, v)
    return RunTween(v, high)
end

local function TweenWithRespawnRetry(target, speed, high, maxAttempts)
    maxAttempts = maxAttempts or 5
    for _ = 1, maxAttempts do
        local startChar, humanoid, root
        for _ = 1, 100 do
            local c = LocalPlayer.Character
            local h = c and c:FindFirstChildOfClass("Humanoid")
            local r = c and c:FindFirstChild("HumanoidRootPart")
            if c and h and h.Health > 0 and r then startChar, humanoid, root = c, h, r; break end
            task.wait(0.1)
        end
        if not humanoid then return false end
        local died = false
        local active = nil
        local diedConn = humanoid.Died:Connect(function() died = true; if active then pcall(function() active:Cancel() end) end end)
        local ok, twO = pcall(function() return Tween(target, speed, high) end)
        if ok and twO then
            active = twO
            local finished, state = false, nil
            local cc = twO.Completed:Connect(function(s) state = s; finished = true end)
            if twO.PlaybackState == Enum.PlaybackState.Completed or twO.PlaybackState == Enum.PlaybackState.Cancelled then state = twO.PlaybackState; finished = true end
            local t0 = tick()
            while not finished and (tick() - t0) < 30 do task.wait(0.05) end
            cc:Disconnect(); diedConn:Disconnect()
            if died or LocalPlayer.Character ~= startChar or humanoid.Health <= 0 then task.wait(0.3)
            elseif state == Enum.PlaybackState.Completed then return true
            else return false end
        else
            diedConn:Disconnect()
            if died or LocalPlayer.Character ~= startChar or humanoid.Health <= 0 then task.wait(0.3)
            else return false end
        end
    end
    return false
end

