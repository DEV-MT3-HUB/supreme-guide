local function FarmLevelLogic()
	CheckQuest()
	SetLevel(LocalPlayer.Data.Level.Value)
	if not Monster then SetStatus("farm | no quest data"); return end
	SetStatus("farm | " .. Monster .. " | lv " .. tostring(LocalPlayer.Data.Level.Value))
	SetItem(Monster)
	SetQuest(NameQuest .. " | " .. tostring(Monster))
	if not GetQuestData() or QuestController.CurrentQuestName ~= NameQuest then
		if CFrameQ then
			if LocalPlayer:DistanceFromCharacter(CFrameQ.Position) > 15 then TweenWithRespawnRetry(CFrameQ, 350) end
			if LocalPlayer:DistanceFromCharacter(CFrameQ.Position) <= 15 then
				CommF_:InvokeServer("StartQuest", NameQuest, LevelQuest)
				task.wait(0.5)
			end
		end
	end
	local foundMob = false
	for _, v in {workspace.Enemies, ReplicatedStorage} do
		for _, v2 in v:GetChildren() do
			if v2:IsA("Model") and v2.Name == Monster then
				local hrp = v2:FindFirstChild("HumanoidRootPart") or v2.PrimaryPart
				if hrp and v2:FindFirstChildOfClass("Humanoid") and v2:FindFirstChildOfClass("Humanoid").Health > 0 then
					foundMob = true
					local startKillThisNPC = tick()
					repeat
						task.wait()
						if not v2 or not v2:FindFirstChildOfClass("Humanoid") or v2:FindFirstChildOfClass("Humanoid").Health <= 0 then break end
						if not GetQuestData() or QuestController.CurrentQuestName ~= NameQuest then TakeQuest() end
						local t = Tween(hrp.Position + Vector3.new(0, 25, 5), 350)
						if LocalPlayer:DistanceFromCharacter(hrp.Position) <= 160 then
							if t then t:Cancel() end
							Tween(hrp.Position + Vector3.new(0, 25, 5), math.huge)
							if LocalPlayer:DistanceFromCharacter(hrp.Position) <= 40 then
								BringEnemy(v2)
								EquipWeapon()
								Attack()
							end
						end
					until not v2 or not v2.Parent or not v2:FindFirstChildOfClass("Humanoid") or v2:FindFirstChildOfClass("Humanoid").Health <= 0 or v2.Name ~= Monster or (tick() - startKillThisNPC) >= 120
					pcall(function() v2:Destroy() end)
					if not CheckMonster(Monster) then break end
				end
			end
		end
		if foundMob then break end
	end
	if not foundMob then
		SetStatus("farm | waiting " .. Monster .. " spawn")
		SetItem("waiting " .. Monster)
		if CFrameMon then TweenWithRespawnRetry(CFrameMon, 350); task.wait(1) end
	end
end

