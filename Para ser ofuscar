local LastTravel = 0
local function RunTween(v, high)
	while not Character or not Character.PrimaryPart or not Character:FindFirstChild("Humanoid") do task.wait() end
	local rootPart = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
	if not rootPart then return end
	if typeof(v) == "CFrame" then v = v.Position end
	Character.Humanoid.Sit = false
	local targetCFrame = typeof(v) == "Vector3" and CFrame.new(v) or v
	local pos = targetCFrame.Position + Vector3.new(0, high or 0, 0)
	local rot = rootPart.CFrame - rootPart.Position
	local finalCFrame = CFrame.new(pos) * rot
	local distance = (rootPart.Position - finalCFrame.Position).Magnitude
	local speed
	if distance < 250 then speed = 285
	elseif distance < 500 then speed = 260
	elseif distance < 1000 then speed = 240
	else speed = 200 end
	tw = TweenService:Create(rootPart, TweenInfo.new(distance / speed, Enum.EasingStyle.Linear, Enum.EasingDirection.Out), { CFrame = finalCFrame })
	tw:Play()
	return tw
end

local function SmartTween(t)
	if World.Sea3() then
		if not CheckItem("Valkyrie Helm") then return end
	end
	if typeof(t) == "CFrame" then t = t.Position end
	while not Character or not Character.PrimaryPart or not Character:FindFirstChild("Humanoid") do task.wait() end
	local _is
	if World.Sea3() then
		_is = {
			{ Vector3.new(-5027.03, 316.55, -3206.70), Vector3.new(5650.95, 1017.27, -350.38) },
			{ Vector3.new(5650.95, 1017.27, -350.38), Vector3.new(-5027.03, 316.55, -3206.70) },
			{ Vector3.new(-12463.60, 378.33, -7566.08), Vector3.new(-5060.41, 316.55, -3193.22) },
			{ Vector3.new(-5060.41, 318.50, -3193.22), Vector3.new(-12463.60, 376.37, -7566.08) },
		}
	elseif World.Sea2() then
		_is = {
			{ Vector3.new(-390, 332, 673), Vector3.new(-390, 332, 673) },
			{ Vector3.new(2285, 15, 905), Vector3.new(2285, 15, 905) },
			{ Vector3.new(923, 126, 32852), Vector3.new(923, 126, 32852) },
			{ Vector3.new(-6509, 83, -133), Vector3.new(-6509, 83, -133) },
		}
	elseif World.Sea1() then
		_is = {
			{ Vector3.new(61163.85, 11.68, 1819.78), Vector3.new(4050.31, -1.69, -1814.12) },
			{ Vector3.new(3864.85, 6.68, -1926.78), Vector3.new(61170.05, -2, 1952.83) },
			{ Vector3.new(-4166.61, 1093.70, -347.16), Vector3.new(-6020.28, 5469.16, 2209.78) },
		}
	else return end
	local min, pos = nil, 1
	for i, v in ipairs(_is) do
		local d = (t - v[1]).Magnitude
		if min == nil or d < min then min = d; pos = i end
	end
	local dist = LocalPlayer:DistanceFromCharacter(t)
	local disttotp = LocalPlayer:DistanceFromCharacter(_is[pos][2])
	if (min + disttotp) < dist and (tick() - LastTravel) >= 1 then
		LastTravel = tick()
		tw = RunTween(_is[pos][2])
		if tw then tw.Completed:Wait() end
		task.wait(0.25)
		if not CollectionService:HasTag(LocalPlayer, "Teleporting") then
			CommF_:InvokeServer("requestEntrance", _is[pos][1])
		end
		repeat task.wait() until (LocalPlayer:DistanceFromCharacter(_is[pos][1]) < LocalPlayer:DistanceFromCharacter(_is[pos][2]))
		task.wait(0.25)
	end
end
local function Tween(v, speed, high)
	while not Character or not Character.PrimaryPart or not Character:FindFirstChild("Humanoid") do task.wait() end
	SmartTween(v)
	return RunTween(v, high)
end

local function WaitForAliveCharacter()
	while true do
		local character = LocalPlayer.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		local root = character and character:FindFirstChild("HumanoidRootPart")
		if character and humanoid and humanoid.Health > 0 and root then return character, humanoid, root end
		task.wait(0.1)
	end
end

local function TweenWithRespawnRetry(target, speed, high)
	while true do
		local startCharacter, humanoid, root = WaitForAliveCharacter()
		local died = false
		local activeTween = nil
		local diedConnection = humanoid.Died:Connect(function()
			died = true
			if activeTween then pcall(function() activeTween:Cancel() end) end
		end)
		local ok, tweenOrError = pcall(function() return Tween(target, speed, high) end)
		if ok and tweenOrError then
			activeTween = tweenOrError
			local finished, playbackState = false, nil
			local completedConnection = activeTween.Completed:Connect(function(state) playbackState = state; finished = true end)
			if activeTween.PlaybackState == Enum.PlaybackState.Completed or activeTween.PlaybackState == Enum.PlaybackState.Cancelled then
				playbackState = activeTween.PlaybackState; finished = true
			end
			if died then pcall(function() activeTween:Cancel() end) end
			while not finished do task.wait(0.05) end
			completedConnection:Disconnect()
			diedConnection:Disconnect()
			local currentCharacter = LocalPlayer.Character
			local stillSameCharacter = currentCharacter == startCharacter and humanoid.Parent ~= nil and humanoid.Health > 0 and root.Parent ~= nil and not died
			if not stillSameCharacter then task.wait(0.1)
			elseif playbackState == Enum.PlaybackState.Completed then return true
			else return false end
		else
			diedConnection:Disconnect()
			local characterChanged = LocalPlayer.Character ~= startCharacter
			if died or characterChanged or humanoid.Health <= 0 or not root.Parent then task.wait(0.1) else return false end
		end
	end
end

