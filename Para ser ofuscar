					repeat
						task.wait()
						if not v or not v.PrimaryPart or not v:FindFirstChildOfClass("Humanoid") or v.Humanoid.Health <= 0 then break end
						Tween(v.PrimaryPart.Position + Vector3.new(0, 25, 7), 350)
