local function EquipTool(v) Character.Humanoid:EquipTool(LocalPlayer.Backpack:FindFirstChild(v)) end
local function EquipWeapon(type)
	type = type or "Melee"
	for _, v in LocalPlayer.Backpack:GetChildren() do
		if v.ToolTip == type then
			if not Character:FindFirstChild("HasBuso") then CommF_:InvokeServer("Buso") end
			Character.Humanoid:EquipTool(v)
			return
		end
	end
end
local function HasItem(name)
	if not Character then return end
	return Character:FindFirstChild(name) or LocalPlayer.Backpack:FindFirstChild(name)
end
local function CheckItem(Name)
	local data = IRS:GetItems(KEYS.QUANTITY)
	for _, v in data do
		local item = MATCH(v.ItemId)._ok
		local c = item.Display.Category
		if (c == "Sword" or c == "Gun" or c == "Accessory") and item.Index.StorageKey == Name then return true end
	end
	return false
end

