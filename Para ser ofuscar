KEYS = require(ReplicatedStorage.ItemReplicationService.KEYS)
IRS = require(ReplicatedStorage.ItemReplicationService)
MATCH = require(ReplicatedStorage.ItemConfig.Storage).match

local function CheckItem(Name)
    local ok, data = pcall(function() return IRS:GetItems(KEYS.QUANTITY) end)
    if not ok or not data then return false end
    for _, v in data do
        local ok2, item = pcall(function() return MATCH(v.ItemId)._ok end)
        if ok2 and item then
            local c = item.Display.Category
            if (c == "Sword" or c == "Gun" or c == "Accessory") and item.Index.StorageKey == Name then return true end
        end
    end
    return false
end
local function GetMaterial(name)
    local ok, data = pcall(function() return IRS:GetItems(KEYS.QUANTITY) end)
    if not ok or not data then return 0 end
    for _, v in data do
        local ok2, item = pcall(function() return MATCH(v.ItemId)._ok end)
        if ok2 and item and item.Display.Category == "Material" and item.Index.StorageKey == name then return v.Value end
    end
    return 0
end

